<form class="vermine2047 sheet item" autocomplete="off">
  <header class="item-entete">
    <img class="item-img" src="{{item.img}}" data-edit="img" />
    <input type="text" name="name" value="{{item.name}}" class="item-nom" />
  </header>

  <section class="item-body">

    {{#if isArme}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Arme.Degats"}}<input type="number" name="system.degats" value="{{system.degats}}" min="0" /></label>
      <label>{{localize "VERMINE.Arme.TypeDommages"}}
        <select name="system.typeDommages">
          {{#each typesDommagesOptions as |d|}}
          <option value="{{d.key}}" {{#if (eq d.key ../system.typeDommages)}}selected{{/if}}>{{d.label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="checkbox">{{localize "VERMINE.Arme.DegatsVigueur"}}<input type="checkbox" name="system.degatsVigueur" {{checked system.degatsVigueur}} /></label>
      <label>{{localize "VERMINE.Arme.Competence"}}
        <select name="system.competence">
          {{#each competencesOptions as |c|}}
          <option value="{{c.key}}" {{#if (eq c.key ../system.competence)}}selected{{/if}}>{{c.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "VERMINE.Arme.PorteeCourte"}}<input type="number" name="system.porteeCourte" value="{{system.porteeCourte}}" min="0" /></label>
      <label>{{localize "VERMINE.Arme.PorteeLongue"}}<input type="number" name="system.porteeLongue" value="{{system.porteeLongue}}" min="0" /></label>
      <label>{{localize "VERMINE.Arme.Fiabilite"}}<input type="number" name="system.fiabilite" value="{{system.fiabilite}}" min="0" /></label>
      <label>{{localize "VERMINE.Arme.Protection"}}<input type="number" name="system.protection" value="{{system.protection}}" min="0" /></label>
      <label>{{localize "VERMINE.Rarete"}}<input type="number" name="system.rarete" value="{{system.rarete}}" min="0" /></label>
    </div>
    {{> systems/vermine2047/templates/item/parts/traits.hbs}}
    {{/if}}

    {{#if isProtection}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Protection.IndiceBase"}}<input type="number" name="system.indiceBase" value="{{system.indiceBase}}" min="0" /></label>
      <label>{{localize "VERMINE.Protection.IndiceSpecifique"}}<input type="number" name="system.indiceSpecifique" value="{{system.indiceSpecifique}}" min="0" /></label>
      <label>{{localize "VERMINE.Protection.TypeSpecifique"}}<input type="text" name="system.typeSpecifique" value="{{system.typeSpecifique}}" placeholder="Balles, gaz…" /></label>
      <label>{{localize "VERMINE.Protection.HandicapMobilite"}}<input type="number" name="system.handicapMobilite" value="{{system.handicapMobilite}}" min="0" max="3" /></label>
      <label>{{localize "VERMINE.Arme.Fiabilite"}}<input type="number" name="system.fiabilite" value="{{system.fiabilite}}" min="0" /></label>
      <label>{{localize "VERMINE.Rarete"}}<input type="number" name="system.rarete" value="{{system.rarete}}" min="0" /></label>
      <label class="checkbox">{{localize "VERMINE.Protection.Equipee"}}<input type="checkbox" name="system.equipee" {{checked system.equipee}} /></label>
    </div>
    {{> systems/vermine2047/templates/item/parts/traits.hbs}}
    {{/if}}

    {{#if isEquipement}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Equipement.Quantite"}}<input type="number" name="system.quantite" value="{{system.quantite}}" min="0" /></label>
      <label>{{localize "VERMINE.Equipement.Poids"}}<input type="number" name="system.poids" value="{{system.poids}}" min="0" step="0.1" /></label>
      <label>{{localize "VERMINE.Rarete"}}<input type="number" name="system.rarete" value="{{system.rarete}}" min="0" /></label>
    </div>
    {{/if}}

    {{#if isAdaptation}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Adaptation.Categorie"}}
        <select name="system.categorie">
          <option value="adaptation" {{#if (eq "adaptation" system.categorie)}}selected{{/if}}>{{localize "VERMINE.Adaptation.Adaptation"}}</option>
          <option value="mutation" {{#if (eq "mutation" system.categorie)}}selected{{/if}}>{{localize "VERMINE.Adaptation.Mutation"}}</option>
        </select>
      </label>
      <label>{{localize "VERMINE.Adaptation.Cout"}}<input type="number" name="system.cout" value="{{system.cout}}" min="1" max="4" /></label>
    </div>
    {{/if}}

    {{#if isTraumatisme}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Traumatisme.Categorie"}}
        <select name="system.categorie">
          <option value="physique" {{#if (eq "physique" system.categorie)}}selected{{/if}}>{{localize "VERMINE.Traumatisme.Physique"}}</option>
          <option value="psychologique" {{#if (eq "psychologique" system.categorie)}}selected{{/if}}>{{localize "VERMINE.Traumatisme.Psychologique"}}</option>
        </select>
      </label>
    </div>
    {{/if}}

    {{#if isHistorique}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Historique.Cout"}}<input type="number" name="system.cout" value="{{system.cout}}" min="1" max="2" /></label>
    </div>
    {{/if}}

    {{#if isAffliction}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Affliction.Categorie"}}
        <select name="system.categorie">
          <option value="maladie" {{#if (eq "maladie" system.categorie)}}selected{{/if}}>{{localize "VERMINE.Affliction.maladie"}}</option>
          <option value="toxine" {{#if (eq "toxine" system.categorie)}}selected{{/if}}>{{localize "VERMINE.Affliction.toxine"}}</option>
          <option value="parasite" {{#if (eq "parasite" system.categorie)}}selected{{/if}}>{{localize "VERMINE.Affliction.parasite"}}</option>
          <option value="addiction" {{#if (eq "addiction" system.categorie)}}selected{{/if}}>{{localize "VERMINE.Affliction.addiction"}}</option>
        </select>
      </label>
      <label>{{localize "VERMINE.Affliction.Virulence"}}<input type="number" name="system.virulence" value="{{system.virulence}}" min="0" max="10" /></label>
      <label>{{localize "VERMINE.Affliction.Duree"}}<input type="text" name="system.duree" value="{{system.duree}}" /></label>
      <label>{{localize "VERMINE.Affliction.Frequence"}}<input type="text" name="system.frequence" value="{{system.frequence}}" /></label>
    </div>
    {{/if}}

    {{#if isRite}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Rite.Cout"}}<input type="number" name="system.cout" value="{{system.cout}}" min="0" /></label>
      <label>{{localize "VERMINE.Rite.Portee"}}<input type="text" name="system.portee" value="{{system.portee}}" /></label>
      <label>{{localize "VERMINE.Rite.Duree"}}<input type="text" name="system.duree" value="{{system.duree}}" /></label>
    </div>
    {{/if}}

    {{#if isProfil}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Profil.Archetype"}}
        <select name="system.archetype">
          <option value="">—</option>
          {{#each archetypesOptions as |a|}}
          <option value="{{a.key}}" {{#if (eq a.key ../system.archetype)}}selected{{/if}}>{{a.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "VERMINE.Profil.Boost"}}<input type="text" name="system.boost" value="{{system.boost}}" /></label>
      <label class="wide">{{localize "VERMINE.Profil.CapaciteUnique"}}<input type="text" name="system.capaciteUnique" value="{{system.capaciteUnique}}" /></label>
      <label class="wide">{{localize "VERMINE.Profil.Competences"}}<input type="text" name="system.competences" value="{{system.competences}}" /></label>
    </div>
    {{/if}}

    {{#if isCapacite}}
    <div class="form-grid">
      <label>{{localize "VERMINE.Capacite.Type"}}
        <select name="system.type">
          {{#each typesCapacite as |t|}}
          <option value="{{t.key}}" {{#if (eq t.key ../system.type)}}selected{{/if}}>{{t.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "VERMINE.Totem.Label"}}
        <select name="system.totem">
          <option value="">—</option>
          {{#each totemsOptions as |t|}}
          <option value="{{t.key}}" {{#if (eq t.key ../system.totem)}}selected{{/if}}>{{t.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "VERMINE.Capacite.Niveau"}}<input type="number" name="system.niveau" value="{{system.niveau}}" min="1" max="3" /></label>
    </div>
    {{/if}}

    <div class="item-description">
      <h4>{{localize "VERMINE.Description"}}</h4>
      <textarea name="system.description" rows="6">{{system.description}}</textarea>
    </div>
  </section>
</form>
