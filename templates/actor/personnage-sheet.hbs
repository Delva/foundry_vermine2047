<form class="vermine2047 sheet personnage" autocomplete="off">

  <header class="fiche-entete">
    <img class="portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="entete-champs">
      <input type="text" name="name" value="{{actor.name}}" class="nom-perso" placeholder="{{localize 'VERMINE.NomPersonnage'}}" />
      <div class="entete-ligne">
        <label>{{localize "VERMINE.Age.Label"}}
          <select name="system.age">
            {{#each VERMINE.ages as |a akey|}}
            <option value="{{akey}}" {{#if (eq akey ../system.age)}}selected{{/if}}>{{localize a.label}}</option>
            {{/each}}
          </select>
        </label>
        <label>{{localize "VERMINE.Mode.Label"}}
          <select name="system.mode">
            {{#each VERMINE.modes as |m mkey|}}
            <option value="{{mkey}}" {{#if (eq mkey ../system.mode)}}selected{{/if}}>{{localize m}}</option>
            {{/each}}
          </select>
        </label>
        <label>{{localize "VERMINE.Totem.Label"}}
          <select name="system.totem">
            <option value="">—</option>
            {{#each VERMINE.totems as |t tkey|}}
            <option value="{{tkey}}" {{#if (eq tkey ../system.totem)}}selected{{/if}}>{{localize t}}</option>
            {{/each}}
          </select>
        </label>
        <label class="rep">{{localize "VERMINE.Reputation"}}
          <input type="number" name="system.reputation" value="{{system.reputation}}" min="0" />
        </label>
        <label class="chaman-check">{{localize "VERMINE.Chaman"}}
          <input type="checkbox" name="system.chaman" {{checked system.chaman}} />
        </label>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs tabs">
    <a class="item" data-tab="principal">{{localize "VERMINE.Onglet.Principal"}}</a>
    <a class="item" data-tab="competences">{{localize "VERMINE.Onglet.Competences"}}</a>
    <a class="item" data-tab="objets">{{localize "VERMINE.Onglet.Objets"}}</a>
    <a class="item" data-tab="bio">{{localize "VERMINE.Onglet.Bio"}}</a>
  </nav>

  <section class="sheet-body">

    {{!-- ONGLET PRINCIPAL --}}
    <div class="tab" data-tab="principal">
      <div class="bloc-caracs">
        <h3>{{localize "VERMINE.Carac.Titre"}}</h3>
        <div class="groupes-carac">
          {{#each groupes as |g gkey|}}
          <div class="groupe">
            <h4>{{g.label}}</h4>
            {{#each g.caracs as |c|}}
            <div class="carac-ligne">
              <a class="carac-nom" data-roll-carac="{{c.key}}" title="{{localize 'VERMINE.Jet.Lancer'}}">{{c.label}}</a>
              <input type="number" name="system.caracteristiques.{{c.key}}.value" value="{{c.value}}" min="0" max="5" />
              <span class="unite">D</span>
            </div>
            {{/each}}
          </div>
          {{/each}}
        </div>
      </div>

      <div class="bloc-reserves">
        <h3>{{localize "VERMINE.Reserve.Titre"}}</h3>
        <div class="reserve">
          <label>{{localize "VERMINE.Reserve.sangFroid"}}</label>
          <input type="number" name="system.reserves.sangFroid.value" value="{{system.reserves.sangFroid.value}}" min="0" />
          <span class="sep">/</span>
          <span class="max">{{system.reserves.sangFroid.max}}</span>
        </div>
        <div class="reserve">
          <label>{{localize "VERMINE.Reserve.effort"}}</label>
          <input type="number" name="system.reserves.effort.value" value="{{system.reserves.effort.value}}" min="0" />
          <span class="sep">/</span>
          <span class="max">{{system.reserves.effort.max}}</span>
        </div>
      </div>

      <div class="bloc-blessures">
        <h3>{{localize "VERMINE.Blessure.Titre"}}</h3>
        {{#each blessuresAff as |b bkey|}}
        <div class="blessure-ligne">
          <span class="blessure-nom">{{b.label}}</span>
          <label class="seuil">{{localize "VERMINE.Blessure.Seuil"}}
            <input type="number" name="system.blessures.{{bkey}}.seuil" value="{{b.seuil}}" min="1" max="10" />
          </label>
          <label class="nb-cercles">{{localize "VERMINE.Blessure.Cercles"}}
            <input type="number" name="system.blessures.{{bkey}}.cercles" value="{{b.cercles}}" min="0" max="12" />
          </label>
          <div class="cercles">
            {{#each b.dots as |d|}}
            <span class="cercle {{#if d.coche}}coche{{/if}}" data-blessure="{{bkey}}" data-index="{{d.index}}"></span>
            {{/each}}
          </div>
        </div>
        {{/each}}
        {{#if system.malusBlessure}}
        <p class="malus">{{localize "VERMINE.Jet.MalusBlessure"}} : −{{system.malusBlessure}}D</p>
        {{/if}}
      </div>
    </div>

    {{!-- ONGLET COMPÉTENCES --}}
    <div class="tab" data-tab="competences">
      <div class="domaines-grid">
        {{#each domaines as |dom dkey|}}
        <div class="domaine">
          <h4>{{dom.label}}</h4>
          {{#each dom.competences as |c|}}
          <div class="competence-ligne">
            <a class="comp-nom" data-roll-competence="{{c.key}}" title="{{localize 'VERMINE.Jet.Lancer'}}">{{c.label}}</a>
            {{#if c.rarete}}<span class="rarete">({{#if (eq c.rarete 1)}}I{{else}}II{{/if}})</span>{{/if}}
            <select name="system.competences.{{c.key}}.niveau">
              {{#each ../../niveauxOptions as |n|}}
              <option value="{{n.key}}" {{#if (eq n.key ../c.niveau)}}selected{{/if}}>{{n.label}}</option>
              {{/each}}
            </select>
            <input type="text" class="specialites" name="spec.{{c.key}}" value="{{join c.specialites ', '}}"
                   placeholder="{{localize 'VERMINE.Comp.Specialites'}}" />
          </div>
          {{/each}}
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- ONGLET OBJETS --}}
    <div class="tab" data-tab="objets">
      {{> systems/vermine2047/templates/actor/parts/liste-objets.hbs titre=(localize "VERMINE.Item.Armes") type="arme" items=armes}}
      {{> systems/vermine2047/templates/actor/parts/liste-objets.hbs titre=(localize "VERMINE.Item.Protections") type="protection" items=protections}}
      {{> systems/vermine2047/templates/actor/parts/liste-objets.hbs titre=(localize "VERMINE.Item.Equipements") type="equipement" items=equipements}}
      {{> systems/vermine2047/templates/actor/parts/liste-objets.hbs titre=(localize "VERMINE.Item.Capacites") type="capacite" items=capacites}}
    </div>

    {{!-- ONGLET BIO --}}
    <div class="tab" data-tab="bio">
      <label>{{localize "VERMINE.Domaine.Predilection"}}
        <select name="system.domainePredilection">
          <option value="">—</option>
          {{#each VERMINE.domaines as |d dkey|}}
          <option value="{{dkey}}" {{#if (eq dkey ../system.domainePredilection)}}selected{{/if}}>{{localize d}}</option>
          {{/each}}
        </select>
      </label>
      <h4>{{localize "VERMINE.Onglet.Bio"}}</h4>
      {{editor enrichedBio target="system.biographie" button=true editable=editable}}
      <h4>{{localize "VERMINE.Notes"}}</h4>
      {{editor enrichedNotes target="system.notes" button=true editable=editable}}
    </div>

  </section>
</form>
